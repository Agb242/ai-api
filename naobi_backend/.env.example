# Copy to .env and fill in the values you need.
# Only DB_HOST / DB_NAME / DB_USER are strictly required to boot the server.

# ---------------------------------------------------------------------------
# LiteLLM Proxy — sole inference and key/spend source of truth.
# Without this, /models, key provisioning and all agent/playground chat calls
# return 503 (LITELLM_NOT_CONFIGURED).
# ---------------------------------------------------------------------------
# Base URL of your running LiteLLM proxy (no trailing slash), e.g.:
#   LITELLM_BASE_URL=http://localhost:4000
#   LITELLM_BASE_URL=https://litellm.your-domain.com
LITELLM_BASE_URL=
# Master key configured on the LiteLLM proxy (used for admin calls: creating
# virtual keys/users, listing models, reading spend). On the proxy side this
# is the LITELLM_MASTER_KEY env var / --master_key flag.
LITELLM_MASTER_KEY=
# Optional overrides — usually fine to leave unset.
LITELLM_HEALTH_PATH=/health/liveliness
LITELLM_CIRCUIT_FAILURES=3
LITELLM_CIRCUIT_OPEN_SECONDS=60

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — required
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=naobi
DB_USER=naobi
DB_PASS=
DB_SSL=false

# ---------------------------------------------------------------------------
# Redis — circuit breaker state, BullMQ queues, realtime hub
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set to false on a machine that shouldn't run the background workers
# (models sync, spend sync, key analytics, cleanup) — e.g. a second API replica.
RUN_BULLMQ_WORKERS=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3018
NODE_ENV=development
API_VERSION=v1
DOMAIN=http://localhost:3018
FRONTEND_URL=http://localhost:3002
# Comma-separated extra CORS origins beyond FRONTEND_URL/localhost.
CORS_ORIGINS=
TIMEZONE=Africa/Brazzaville
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# AES-256-GCM key used to encrypt virtual LiteLLM keys / OAuth tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
SESSION_EXPIRY_DAYS=30
SESSION_REFRESH_BEFORE_DAYS=7

# ---------------------------------------------------------------------------
# Auth — Google OAuth (optional, OTP login works without this)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Mail (OTP codes, budget alerts) — SMTP
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noabi <noreply@noabi.local>

# ---------------------------------------------------------------------------
# Mobile Money (SebPay Collectes) — pack purchases
# ---------------------------------------------------------------------------
# simulate = auto-approve after SIMULATE_APPROVE_MS, no external call (default)
# live     = real calls to COLLECTES_API_URL
PAYMENT_MODE=simulate
SIMULATE_APPROVE_MS=5000
COLLECTES_API_URL=https://newapi.sebpay.bj/api/v1
COLLECTES_PUBLIC_KEY=
COLLECTES_SECRET_KEY=
COLLECTES_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=90
