# Nginx — API backend (api.knotflow.cloud)
# Proxy vers Koa (PORT=3020). CORS géré par le backend — ne pas intercepter OPTIONS ici.
#
# sudo ln -sf /etc/nginx/sites-available/api_knotflow.conf /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name api.knotflow.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.knotflow.cloud;

    ssl_certificate     /etc/letsencrypt/live/api.knotflow.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.knotflow.cloud/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 500M;

    location /ws {
        proxy_pass         http://127.0.0.1:3020;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade         $http_upgrade;
        proxy_set_header   Connection      "upgrade";
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location / {
        proxy_pass         http://127.0.0.1:3020;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_buffering    off;
    }
}
