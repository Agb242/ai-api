# Copy to .env.local and fill in the values you need.
# The frontend never talks to LiteLLM directly — it calls naobi_backend, which
# proxies to LiteLLM. Configure LITELLM_BASE_URL / LITELLM_MASTER_KEY in
# naobi_backend/.env instead.

# Base URL of naobi_backend's REST API (Koa), including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3018/api/v1

# Optional: OpenAI-compatible gateway base URL for curl snippets shown in the
# Playground (defaults to NEXT_PUBLIC_API_URL with /api/v1 stripped).
NEXT_PUBLIC_GATEWAY_URL=

# Optional: Google Sign-In client ID (login also works via OTP without this).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: cookie domain override for the auth-token cookie on custom domains,
# e.g. ".your-domain.com". Leave unset for localhost / default hosting.
NEXT_PUBLIC_COOKIE_DOMAIN=
