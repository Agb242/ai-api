# Mode de paiement : "simulate" (auto-approbation après 5s) ou "live" (vrais appels SebPay)
PAYMENT_MODE=simulate

# Délai d'auto-approbation en mode simulate (ms)
SIMULATE_APPROVE_MS=5000

# --- API Collectes SebPay (mode live) ---
COLLECTES_API_URL=https://newapi.sebpay.bj/api/v1
COLLECTES_PUBLIC_KEY=pk_live_votre_cle_publique
COLLECTES_SECRET_KEY=sk_live_votre_cle_secrete

# --- LiteLLM Proxy ---
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Serveur ---
PORT=3000
